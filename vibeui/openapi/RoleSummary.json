{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoleSummary",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "hasJobList": { "type": "boolean" },
    "subroles": { "type": "object", "additionalProperties": { "type": "string", "format": "uri" } },
    "agents": { "type": "object", "additionalProperties": { "type": "string", "format": "uri" } }
  },
  "required": ["name", "hasJobList"]
}
