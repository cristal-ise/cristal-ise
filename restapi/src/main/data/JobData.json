{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JobData",
  "type": "object",
  "properties": {
    "agent": { "type": "string" },
    "roleOverride": { "type": "string" },
    "item": {
      "type": "object",
      "properties": {
        "uuid": { "type": "string", "format": "uuid" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      },
      "required": ["uuid", "name", "url"]
    },
    "activity": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "path": { "type": "string" },
        "type": { "type": "string" },
        "properties": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "required": ["name", "path", "type", "properties"]
    },
    "transition": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "id": { "type": "integer" },
        "origin": { "type": "string" },
        "target": { "type": "string" },
        "stateMachine": { "type": "string" },
        "stateMachineVersion": { "type": "string" },
        "stateMachineUrl": { "type": "string", "format": "uri" }
      },
      "required": ["name", "id", "origin", "target", "stateMachine", "stateMachineVersion", "stateMachineUrl"]
    },
    "outcome": {
      "type": "object",
      "properties": {
        "required": { "type": "boolean" },
        "schema": { "type": "string" },
        "schemaVersion": { "type": "integer" },
        "schemaUrl": { "type": "string", "format": "uri" },
        "formTemplateUrl": { "type": "string", "format": "uri" }
      },
      "required": ["required", "schema", "schemaVersion", "schemaUrl", "formTemplateUrl"]
    },
    "attachmentMimeTypes": { "type": "string" }
  },
  "required": ["item", "activity", "transition"]
}
